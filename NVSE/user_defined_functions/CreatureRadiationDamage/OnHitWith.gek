ref rTarget
ref rWeapon

float fDamage
ref rAttacker
array_var aFactions
array_var aIter
array_var aResult

begin Function {rTarget, rWeapon}

	; Validate attacker
	if eval IsReference (rAttacker = rTarget.GetHitAttacker) == 0
		return
	endif
	aFactions = GetBaseFactions rAttacker
	aResult = &(ar_FindWhere aFactions ({aIter} => AuxVarGetFlt "*InflictRadDamage" 0 (*aIter) > 0))
	fDamage = ((TypeOf *aResult) != "Number" || (*aResult != 0) || (AuxVarGetFlt "*InflictRadDamage" 0 (rAttacker.GBF) > 0))
	aFactions = aIter = aResult = ar_Null
	if eval fDamage == 0
		return
	endif

	; Apply effect to player
	fDamage = GetMaxOf (Goo1.AuxVarGetFlt "*GIRD_INI" 1) ((rTarget.GetHitHealthDamage) * Goo1.AuxVarGetFlt "*GIRD_INI" 0)
	if eval fDamage > 0
		SetNthEffectTraitNumeric GoldenGeckoRadiation 0 0 fDamage
		Player.CastImmediate GoldenGeckoRadiation; rAttacker
	endif

end